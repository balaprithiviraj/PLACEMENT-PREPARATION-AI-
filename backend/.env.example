# Copy to .env (never commit .env). Backend only — keys never reach the browser.
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3-flash-preview
# Optional fallback: OpenCode Zen free model (OpenAI-compatible).
# Get a key at https://opencode.ai/zen (sign in, copy API key).
# Free models use POST {ZEN_BASE_URL}/chat/completions, e.g. mimo-v2.5-free.
ZEN_API_KEY=
ZEN_MODEL=mimo-v2.5-free
ZEN_BASE_URL=https://opencode.ai/zen/v1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
