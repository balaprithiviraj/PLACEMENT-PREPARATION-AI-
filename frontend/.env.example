# Local development: leave this unset or use the FastAPI local URL.
# VITE_API_URL=http://localhost:8000/api

# Production with a separate backend project:
# VITE_API_URL=https://your-backend-domain/api

# Production with the same Vercel monorepo setup:
# Leave VITE_API_URL unset and rely on the /api rewrite in vercel.json.
